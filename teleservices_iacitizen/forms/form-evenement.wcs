      <id type="str">a1f0c001-0000-4000-8000-000000000008</id>
    </field>
    <field>
      <type>string</type>
      <label type="str">Nombre d'occurrences</label>
      <condition>
        <type>django</type>
        <value>form_var_recurrent and form_var_rrule_fin_raw == "count"</value>
      </condition>
      <required type="str">required</required>
      <hint type="str">&lt;p&gt;Premi&#232;re occurrence comprise&lt;/p&gt;</hint>
      <varname type="str">rrule_count</varname>
      <display_locations>
        <item>validation</item>
        <item>summary</item>
      </display_locations>
      <extra_css_class type="str">grid-1-3 pk-important</extra_css_class>
      <anonymise type="str">no</anonymise>
      <validation>
        <error_message>Veuillez saisir un nombre entre 1 et 999</error_message>
        <type>regex</type>
        <value>^[1-9][0-9]{0,2}$</value>
      </validation>
      <id type="str">a1f0c001-0000-4000-8000-000000000009</id>
    </field>
    <field>
      <type>date</type>
      <label type="str">Jusqu'au (inclus)</label>
      <condition>
        <type>django</type>
        <value>form_var_recurrent and form_var_rrule_fin_raw == "until"</value>
      </condition>
      <required type="str">required</required>
      <varname type="str">rrule_until</varname>
      <display_locations>
        <item>validation</item>
        <item>summary</item>
      </display_locations>
      <extra_css_class type="str">grid-1-3 pk-important</extra_css_class>
      <anonymise type="str">no</anonymise>
      <minimum_is_future type="bool">True</minimum_is_future>
      <date_in_the_past type="bool">False</date_in_the_past>
      <date_can_be_today type="bool">True</date_can_be_today>
      <id type="str">a1f0c001-0000-4000-8000-00000000000a</id>
    </field>
    <field>
      <type>comment</type>
      <label type="str">&lt;div class="infonotice"&gt;{% with i=form_var_rrule_interval|default:"1"|add:0 freq=form_var_rrule_freq_raw j=form_var_date_debut|date:"j" u=form_var_rrule_until|date:"j" %}
&lt;p&gt;Votre &#233;v&#233;nement aura lieu
{% if freq == "DAILY" %}{% if i == 1 %}tous les jours,{% elif i == 2 %}un jour sur deux,{% else %}tous les {{ i }} jours,{% endif %}
{% elif freq == "WEEKLY" %}{% if i == 1 %}toutes les semaines{% elif i == 2 %}une semaine sur deux{% else %}toutes les {{ i }} semaines{% endif %}, {% if form_var_rrule_byday %}{% for d in form_var_rrule_byday|split:", " %}{% if not forloop.first %}{% if forloop.last %} et {% else %}, {% endif %}{% endif %}le {{ d|lower }}{% endfor %}{% else %}le {{ form_var_date_debut|date:"l" }}{% endif %},
{% elif freq == "MONTHLY" %}{% if i == 1 %}tous les mois{% elif i == 2 %}un mois sur deux{% else %}tous les {{ i }} mois{% endif %}, {% if form_var_rrule_mois_mode_raw == "weekday" %}{% if form_var_rrule_mois_position and form_var_rrule_mois_jour %}le {{ form_var_rrule_mois_position|lower }} {{ form_var_rrule_mois_jour|lower }} du mois,{% else %}&#224; un jour &#224; pr&#233;ciser,{% endif %}{% else %}le {% if j == "1" %}1er{% else %}{{ j }}{% endif %} du mois,{% endif %}
{% elif freq == "YEARLY" %}{% if i == 1 %}tous les ans{% elif i == 2 %}un an sur deux{% else %}tous les {{ i }} ans{% endif %}, le {% if j == "1" %}1er{% else %}{{ j }}{% endif %} {{ form_var_date_debut|date:"F" }},
{% endif %}
&#224; partir du {% if j == "1" %}1er{% else %}{{ j }}{% endif %} {{ form_var_date_debut|date:"F Y" }}{% if form_var_rrule_fin_raw == "count" and form_var_rrule_count %}{% if form_var_rrule_count|add:0 == 1 %}, pour une seule occurrence{% else %}, pour un total de {{ form_var_rrule_count }} occurrences{% endif %}{% elif form_var_rrule_fin_raw == "until" and form_var_rrule_until %}, jusqu'au {% if u == "1" %}1er{% else %}{{ u }}{% endif %} {{ form_var_rrule_until|date:"F Y" }} inclus{% endif %}.&lt;/p&gt;
{% if freq == "MONTHLY" and form_var_rrule_mois_mode_raw != "weekday" and j|add:0 &gt;= 29 %}&lt;p&gt;&lt;strong&gt;Attention :&lt;/strong&gt; les mois qui ne comptent pas de {{ j }} ne seront pas concern&#233;s.&lt;/p&gt;{% endif %}
{% if freq == "YEARLY" and form_var_date_debut|date:"d/m" == "29/02" %}&lt;p&gt;&lt;strong&gt;Attention :&lt;/strong&gt; l'&#233;v&#233;nement n'aura lieu que les ann&#233;es bissextiles.&lt;/p&gt;{% endif %}
{% endwith %}&lt;/div&gt;
</label>
      <condition>
        <type>django</type>
        <value>form_var_recurrent and form_var_rrule_freq_raw and form_var_date_debut</value>
      </condition>
      <display_locations />
      <id type="str">a72d93f5-dd3c-471e-ab59-061b8aab61f4</id>
    </field>
