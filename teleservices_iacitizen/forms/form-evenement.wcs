      <image_mobile_size type="str">75</image_mobile_size>
      <radio_orientation type="str">auto</radio_orientation>
      <id type="str">37</id>
    </field>
    <field>
      <type>items</type>
      <label type="str">Public cible</label>
      <required type="str">optional</required>
      <varname type="str">public_cible</varname>
      <display_locations>
        <item>validation</item>
        <item>summary</item>
      </display_locations>
      <extra_css_class type="str">pk-important</extra_css_class>
      <anonymise type="str">final</anonymise>
      <items />
      <display_mode type="str">checkboxes</display_mode>
      <min_choices type="int">0</min_choices>
      <max_choices type="int">0</max_choices>
      <data_source>
        <type>json</type>
        <value>{{ passerelle_url }}plone-restapi/evenements/get_field_choices?id=collective.taxonomy.event_public</value>
      </data_source>
      <in_filters type="bool">False</in_filters>
      <display_disabled_items type="bool">False</display_disabled_items>
      <image_desktop_size type="str">150</image_desktop_size>
      <image_mobile_size type="str">75</image_mobile_size>
      <id type="str">38</id>
    </field>
    <field>
      <type>items</type>
      <label type="str">Th&#233;matiques</label>
      <required type="str">optional</required>
      <varname type="str">thematiques</varname>
      <display_locations>
        <item>validation</item>
        <item>summary</item>
      </display_locations>
      <extra_css_class type="str">pk-important</extra_css_class>
      <anonymise type="str">final</anonymise>
      <items />
      <display_mode type="str">checkboxes</display_mode>
      <min_choices type="int">0</min_choices>
      <max_choices type="int">0</max_choices>
      <data_source>
        <type>json</type>
        <value>{{ passerelle_url }}plone-restapi/evenements/get_field_choices?id=imio.smartweb.vocabulary.Topics</value>
      </data_source>
      <in_filters type="bool">False</in_filters>
      <display_disabled_items type="bool">False</display_disabled_items>
      <image_desktop_size type="str">150</image_desktop_size>
      <image_mobile_size type="str">75</image_mobile_size>
      <id type="str">39</id>
    </field>
    <field>
      <type>items</type>
      <label type="str">Je suis (mon public)</label>
      <required type="str">optional</required>
      <hint type="str">&lt;p&gt;Merci d'indiquer &#224; quel public s'adresse directement votre publication.&lt;/p&gt;</hint>
      <varname type="str">je_suis</varname>
      <display_locations>
        <item>validation</item>
        <item>summary</item>
      </display_locations>
      <extra_css_class type="str">pk-important</extra_css_class>
      <anonymise type="str">final</anonymise>
      <items />
      <display_mode type="str">checkboxes</display_mode>
      <min_choices type="int">0</min_choices>
      <max_choices type="int">0</max_choices>
      <data_source>
        <type>json</type>
        <value>{{ passerelle_url }}plone-restapi/evenements/get_field_choices?id=imio.smartweb.vocabulary.IAm</value>
      </data_source>
      <in_filters type="bool">False</in_filters>
      <display_disabled_items type="bool">False</display_disabled_items>
      <image_desktop_size type="str">150</image_desktop_size>
      <image_mobile_size type="str">75</image_mobile_size>
      <id type="str">40</id>
    </field>
    <field>
      <type>item</type>
      <label type="str">Langue</label>
      <required type="str">optional</required>
      <varname type="str">langue</varname>
      <display_locations>
        <item>validation</item>
        <item>summary</item>
      </display_locations>
      <extra_css_class type="str">pk-important</extra_css_class>
      <anonymise type="str">no</anonymise>
      <display_mode type="str">list</display_mode>
      <items />
      <data_source>
        <type>json</type>
        <value>{{ passerelle_url }}plone-restapi/evenements/get_field_choices?id=plone.app.vocabularies.SupportedContentLanguages</value>
      </data_source>
      <in_filters type="bool">False</in_filters>
      <display_disabled_items type="bool">False</display_disabled_items>
      <initial_zoom type="str">13</initial_zoom>
      <use_hint_as_first_option type="bool">True</use_hint_as_first_option>
      <image_desktop_size type="str">150</image_desktop_size>
      <image_mobile_size type="str">75</image_mobile_size>
      <radio_orientation type="str">auto</radio_orientation>
      <id type="str">42</id>
    </field>
    <field>
      <type>bool</type>
      <label type="str">Exclure de la navigation</label>
      <condition>
        <type>django</type>
        <value>is_in_backoffice</value>
      </condition>
      <required type="str">optional</required>
      <varname type="str">exclure</varname>
      <display_locations>
        <item>validation</item>
        <item>summary</item>
      </display_locations>
      <extra_css_class type="str">pk-important</extra_css_class>
      <anonymise type="str">no</anonymise>
      <id type="str">15</id>
    </field>
    <field>
      <type>subtitle</type>
      <label type="str">Vos coordonn&#233;es</label>
      <display_locations>
        <item>validation</item>
        <item>summary</item>
      </display_locations>
      <id type="str">de2ac482-caca-43cf-adc7-1f597cb46b76</id>
    </field>
    <field>
      <type>comment</type>
      <label type="str">&lt;p&gt;Ces informations nous permettent de vous recontacter au sujet de votre demande. Elles ne seront pas publi&#233;es.&lt;/p&gt;</label>
      <display_locations />
      <id type="str">740a718b-5064-4ab9-afcf-0e99c28f2929</id>
    </field>
    <field>
      <type>string</type>
      <label type="str">Nom</label>
      <required type="str">optional</required>
      <display_locations>
        <item>validation</item>
        <item>summary</item>
      </display_locations>
      <extra_css_class type="str">grid-1-2 pk-important</extra_css_class>
      <prefill>
        <type>user</type>
        <value>_last_name</value>
      </prefill>
      <anonymise type="str">final</anonymise>
      <id type="str">48</id>
    </field>
    <field>
      <type>string</type>
      <label type="str">Pr&#233;nom</label>
      <required type="str">optional</required>
      <display_locations>
        <item>validation</item>
        <item>summary</item>
      </display_locations>
      <extra_css_class type="str">grid-1-2 pk-important</extra_css_class>
      <prefill>
        <type>user</type>
        <value>_first_name</value>
      </prefill>
      <anonymise type="str">final</anonymise>
      <id type="str">49</id>
    </field>
    <field>
      <type>email</type>
      <label type="str">Adresse e-mail</label>
      <required type="str">required</required>
      <varname type="str">mail</varname>
      <display_locations>
        <item>validation</item>
        <item>summary</item>
      </display_locations>
      <extra_css_class type="str">grid-1-2 pk-important</extra_css_class>
      <prefill>
        <type>user</type>
        <value>_email</value>
      </prefill>
      <anonymise type="str">final</anonymise>
      <id type="str">50</id>
    </field>
    <field>
      <type>computed</type>
      <label type="str">R&#232;gle de r&#233;currence (RRULE)</label>
      <varname type="str">recurrence</varname>
      <value_template type="str">{% if form_var_recurrent %}RRULE:FREQ={{ form_var_rrule_freq_raw }}{% if form_var_rrule_interval and form_var_rrule_interval != "1" %};INTERVAL={{ form_var_rrule_interval }}{% endif %}{% if form_var_rrule_freq_raw == "WEEKLY" and form_var_rrule_byday_raw %};BYDAY={% for d in form_var_rrule_byday_raw %}{{ d }}{% if not forloop.last %},{% endif %}{% endfor %}{% elif form_var_rrule_freq_raw == "MONTHLY" and form_var_rrule_mois_mode_raw == "weekday" %};BYDAY={{ form_var_rrule_mois_position_raw }}{{ form_var_rrule_mois_jour_raw }}{% endif %}{% if form_var_rrule_fin_raw == "count" %};COUNT={{ form_var_rrule_count }}{% elif form_var_rrule_fin_raw == "until" %};UNTIL={{ form_var_rrule_until|date:"Ymd" }}T235959Z{% endif %}{% endif %}</value_template>
      <freeze_on_initial_value type="bool">False</freeze_on_initial_value>
      <id type="str">a1f0c001-0000-4000-8000-00000000000b</id>
    </field>
  </fields>
  <user-roles>
    <role role_id="logged-users">logged-users</role>
  </user-roles>
  <backoffice-submission-roles>
    <role slug="agents-traitants-informatique" role_id="dcc1e1a25e01457aa06ac7347640a854">Agents traitants - Informatique</role>
  </backoffice-submission-roles>
  <roles>
    <role slug="agents-traitants-informatique" role_id="dcc1e1a25e01457aa06ac7347640a854" role_key="_editor">Agents traitants - Informatique</role>
  </roles>
  <options>
    <option varname="plone_folder">rochefort/citoyens</option>
    <option varname="type">&#201;v&#233;nement</option>
    <option varname="type_display">&#201;v&#233;nement</option>
    <option varname="type_structured" />
  </options>
  <custom_views>
    <custom_view>
      <title>Vue par d&#233;faut des demandes de publication citoyennes (&#201;v&#233;nements)</title>
      <slug>vue-par-defaut-des-demandes-de-publication-citoyennes-evenements</slug>
      <visibility>any</visibility>
      <filters>
        <filter>waiting</filter>
        <filter-1>on</filter-1>
        <filter-1-operator>eq</filter-1-operator>
        <filter-27>on</filter-27>
        <filter-27-operator>eq</filter-27-operator>
        <filter-44>on</filter-44>
        <filter-44-operator>eq</filter-44-operator>
        <filter-48>on</filter-48>
        <filter-48-operator>eq</filter-48-operator>
        <filter-49>on</filter-49>
        <filter-49-operator>eq</filter-49-operator>
        <filter-9>on</filter-9>
        <filter-9-operator>eq</filter-9-operator>
        <filter-operator>eq</filter-operator>
        <filter-status>on</filter-status>
      </filters>
      <is_default>False</is_default>
      <columns>
        <id>id</id>
        <id>time</id>
        <id>last_update_time</id>
        <id>user-label</id>
        <id>8</id>
        <id>status</id>
        <id>1</id>
        <id>9</id>
      </columns>
      <order_by>-receipt_time</order_by>
    </custom_view>
  </custom_views>
  <geolocations />
  <management_sidebar_items>
    <item>__default__</item>
  </management_sidebar_items>
  <submission_sidebar_items>
    <item>__default__</item>
  </submission_sidebar_items>
  <digest_templates>
    <template key="default">{{ form_var_titre }}</template>
  </digest_templates>
</formdef>