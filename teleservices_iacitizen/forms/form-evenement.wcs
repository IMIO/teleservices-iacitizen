<?xml version="1.0"?>
<formdef id="106" url="https://rochefort-formulaires.guichet-citoyen.be/backoffice/forms/106/">
  <name>&#201;v&#233;nement</name>
  <url_name>evenement</url_name>
  <submission_user_association>any</submission_user_association>
  <history_pane_default_mode>expanded</history_pane_default_mode>
  <discussion>false</discussion>
  <detailed_emails>true</detailed_emails>
  <disabled>true</disabled>
  <hidden>false</hidden>
  <only_allow_one>false</only_allow_one>
  <enable_tracking_codes>false</enable_tracking_codes>
  <confirmation>true</confirmation>
  <always_advertise>false</always_advertise>
  <has_captcha>false</has_captcha>
  <skip_from_360_view>false</skip_from_360_view>
  <category slug="publications" category_id="18">Publications</category>
  <workflow slug="contributions" workflow_id="36">iA.Citizen - Publications (actualit&#233;s, &#233;v&#233;nements, fiches annuaires)</workflow>
  <fields>
    <field>
      <type>page</type>
      <label type="str">Soumettre un &#233;v&#233;nement</label>
      <post_conditions>
        <post_condition>
          <condition>
            <type>django</type>
            <value>form_var_date_debut|add:" "|add:form_var_horaire_debut|datetime &lt;= form_var_date_fin|add:" "|add:form_var_horaire_fin|datetime or not form_var_horaire_debut and not form_var_horaire_fin</value>
          </condition>
          <error_message>La date de d&#233;but doit &#234;tre avant la date de fin</error_message>
        </post_condition>
        <post_condition>
          <condition>
            <type>django</type>
            <value>not form_var_recurrent or form_var_rrule_fin_raw != "until" or form_var_rrule_until|date:"Y-m-d" &gt;= form_var_date_debut|date:"Y-m-d"</value>
          </condition>
          <error_message>La date de fin de r&#233;currence doit &#234;tre post&#233;rieure ou &#233;gale &#224; la date de d&#233;but</error_message>
        </post_condition>
      </post_conditions>
      <id type="str">46</id>
    </field>
    <field>
      <type>title</type>
      <label type="str">Soumettre un &#233;v&#233;nement</label>
      <display_locations>
        <item>validation</item>
        <item>summary</item>
      </display_locations>
      <id type="str">52</id>
    </field>
    <field>
      <type>comment</type>
      <label type="str">&lt;p&gt;Proposez un &#233;v&#233;nement &#224; publier dans l&#8217;agenda. Votre demande sera relue par nos services avant sa mise en ligne.&lt;/p&gt;&lt;p&gt;Les champs marqu&#233;s d&#8217;un ast&#233;risque (*) sont obligatoires.&lt;/p&gt;</label>
      <display_locations />
      <id type="str">fd26d649-d018-4eea-95bf-a9bf8880a02e</id>
    </field>
    <field>
      <type>subtitle</type>
      <label type="str">L&#8217;&#233;v&#233;nement</label>
      <display_locations>
        <item>validation</item>
        <item>summary</item>
      </display_locations>
      <id type="str">9fb2f407-7bc8-4dbb-a875-ab95b8e7e947</id>
    </field>
    <field>
      <type>item</type>
      <label type="str">Type d'&#233;v&#233;nement</label>
      <required type="str">required</required>
      <hint type="str">&lt;p&gt;S&#233;lectionnez&lt;/p&gt;</hint>
      <varname type="str">type_event</varname>
      <display_locations>
        <item>validation</item>
        <item>summary</item>
      </display_locations>
      <extra_css_class type="str">pk-important</extra_css_class>
      <anonymise type="str">no</anonymise>
      <display_mode type="str">list</display_mode>
      <items />
      <data_source>
        <type>json</type>
        <value>{{ passerelle_url }}plone-restapi/evenements/get_field_choices?id=imio.events.vocabulary.EventTypes</value>
      </data_source>
      <in_filters type="bool">False</in_filters>
      <display_disabled_items type="bool">False</display_disabled_items>
      <initial_zoom type="str">13</initial_zoom>
      <use_hint_as_first_option type="bool">True</use_hint_as_first_option>
      <image_desktop_size type="str">150</image_desktop_size>
      <image_mobile_size type="str">75</image_mobile_size>
      <radio_orientation type="str">auto</radio_orientation>
      <id type="str">44</id>
    </field>
    <field>
      <type>string</type>
      <label type="str">Titre</label>
      <required type="str">required</required>
      <varname type="str">titre</varname>
      <display_locations>
        <item>validation</item>
        <item>summary</item>
      </display_locations>
      <extra_css_class type="str">grid-1-1 pk-important</extra_css_class>
      <anonymise type="str">final</anonymise>
      <maxlength type="str">150</maxlength>
      <id type="str">1</id>
    </field>
    <field>
      <type>text</type>
      <label type="str">Description courte</label>
      <required type="str">optional</required>
      <hint type="str">&lt;p&gt;R&#233;sum&#233; de l'&#233;v&#233;nement en quelques phrases maximum.&lt;/p&gt;</hint>
      <varname type="str">description</varname>
      <display_locations>
        <item>validation</item>
        <item>summary</item>
      </display_locations>
      <extra_css_class type="str">grid-1-1 pk-important</extra_css_class>
      <anonymise type="str">final</anonymise>
      <display_mode type="str">plain</display_mode>
      <maxlength type="str">700</maxlength>
      <id type="str">2</id>
    </field>
    <field>
      <type>text</type>
      <label type="str">Texte de pr&#233;sentation</label>
      <required type="str">optional</required>
      <varname type="str">texte</varname>
      <display_locations>
        <item>validation</item>
        <item>summary</item>
      </display_locations>
      <extra_css_class type="str">grid-1-1 pk-important</extra_css_class>
      <anonymise type="str">final</anonymise>
      <display_mode type="str">plain</display_mode>
      <id type="str">51</id>
    </field>
    <field>
      <type>subtitle</type>
      <label type="str">Visuel et document</label>
      <display_locations>
        <item>validation</item>
        <item>summary</item>
      </display_locations>
      <id type="str">b6d1e954-47b2-4213-b7cf-197f34e606b1</id>
    </field>
    <field>
      <type>file</type>
      <label type="str">Image principale (sans texte)</label>
      <required type="str">required</required>
      <hint type="str">&lt;p&gt;Les images comportant du texte ne sont pas visibles dans leur enti&#232;ret&#233;&amp;nbsp;; merci de t&#233;l&#233;verser une image sans texte.&lt;/p&gt;</hint>
      <varname type="str">image</varname>
      <display_locations>
        <item>validation</item>
        <item>summary</item>
        <item>listings</item>
      </display_locations>
      <extra_css_class type="str">grid-1-1 pk-important</extra_css_class>
      <anonymise type="str">final</anonymise>
      <automatic_image_resize type="bool">False</automatic_image_resize>
      <storage type="str">default</storage>
      <id type="str">8</id>
    </field>
    <field>
      <type>bool</type>
      <label type="str">Je certifie que les images fournies respectent les droits d&#8217;auteur, qu&#8217;elles sont libres de droits ou d&#251;ment autoris&#233;es, et j&#8217;en assume l&#8217;enti&#232;re responsabilit&#233; en cas d&#8217;utilisation illicite.</label>
      <required type="str">required</required>
      <varname type="str">je_certifie_que_les_images_fournies_respectent_les_droits_d_auteur_qu_elles_sont_libres_de_droits_ou_dument_autorisees_et_j_en_assume_l_entiere_responsabilite_en_cas_d_utilisation_illicite</varname>
      <display_locations>
        <item>validation</item>
        <item>summary</item>
      </display_locations>
      <extra_css_class type="str">pk-important</extra_css_class>
      <anonymise type="str">no</anonymise>
      <id type="str">dc9eff1b-a7c2-4f51-9a32-11ee4e30eaae</id>
    </field>
    <field>
      <type>file</type>
      <label type="str">Document</label>
      <condition>
        <type>django</type>
        <value>false</value>
      </condition>
      <required type="str">optional</required>
      <hint type="str">&lt;p&gt;Programme, affiche, plan d&#8217;acc&#232;s&#8230;&lt;/p&gt;</hint>
      <varname type="str">document</varname>
      <display_locations>
        <item>validation</item>
        <item>summary</item>
      </display_locations>
      <extra_css_class type="str">pk-important</extra_css_class>
      <anonymise type="str">final</anonymise>
      <max_file_size type="str">10 Mo</max_file_size>
      <automatic_image_resize type="bool">True</automatic_image_resize>
      <storage type="str">default</storage>
      <id type="str">05003ff7-5b1b-4cce-9f54-c80cfa9f8600</id>
    </field>
    <field>
      <type>subtitle</type>
      <label type="str">Date et horaires</label>
      <display_locations>
        <item>validation</item>
        <item>summary</item>
      </display_locations>
      <id type="str">a20f8e42-d621-4b17-8e8a-5bccad626f31</id>
    </field>
    <field>
      <type>bool</type>
      <label type="str">Journ&#233;e enti&#232;re</label>
      <required type="str">optional</required>
      <varname type="str">journee_entiere</varname>
      <display_locations>
        <item>validation</item>
        <item>summary</item>
      </display_locations>
      <extra_css_class type="str">grid-1-2 pk-important</extra_css_class>
      <anonymise type="str">no</anonymise>
      <id type="str">25</id>
    </field>
    <field>
      <type>bool</type>
      <label type="str">Dur&#233;e ind&#233;termin&#233;e</label>
      <required type="str">optional</required>
      <hint type="str">&lt;p&gt;Cochez si l&#8217;heure de fin n&#8217;est pas connue.&lt;/p&gt;</hint>
      <varname type="str">duree_indeterminee</varname>
      <display_locations>
        <item>validation</item>
        <item>summary</item>
      </display_locations>
      <extra_css_class type="str">grid-1-2 pk-important</extra_css_class>
      <anonymise type="str">no</anonymise>
      <id type="str">26</id>
    </field>
    <field>
      <type>date</type>
      <label type="str">Date de d&#233;but</label>
      <required type="str">required</required>
      <varname type="str">date_debut</varname>
      <display_locations>
        <item>validation</item>
        <item>summary</item>
      </display_locations>
      <extra_css_class type="str">grid-2-3 pk-important</extra_css_class>
      <anonymise type="str">final</anonymise>
      <minimum_is_future type="bool">True</minimum_is_future>
      <date_in_the_past type="bool">False</date_in_the_past>
      <date_can_be_today type="bool">True</date_can_be_today>
      <id type="str">20</id>
    </field>
    <field>
      <type>string</type>
      <label type="str">Horaire d&#233;but</label>
      <condition>
        <type>django</type>
        <value>not form_var_journee_entiere</value>
      </condition>
      <required type="str">optional</required>
      <hint type="str">&lt;p&gt;Ex.&#160;: 08:00&lt;/p&gt;</hint>
      <varname type="str">horaire_debut</varname>
      <display_locations>
        <item>validation</item>
        <item>summary</item>
      </display_locations>
      <extra_css_class type="str">grid-1-3 pk-important</extra_css_class>
      <prefill>
        <type>string</type>
        <value>00:00</value>
      </prefill>
      <anonymise type="str">final</anonymise>
      <validation>
        <type>regex</type>
        <value>^([0-1][0-9]|2[0-3]):[0-5][0-9]$</value>
      </validation>
      <id type="str">22</id>
    </field>
    <field>
      <type>date</type>
      <label type="str">Date de fin</label>
      <required type="str">required</required>
      <varname type="str">date_fin</varname>
      <display_locations>
        <item>validation</item>
        <item>summary</item>
      </display_locations>
      <extra_css_class type="str">grid-2-3 pk-important</extra_css_class>
      <anonymise type="str">final</anonymise>
      <minimum_is_future type="bool">True</minimum_is_future>
      <date_in_the_past type="bool">False</date_in_the_past>
      <date_can_be_today type="bool">True</date_can_be_today>
      <id type="str">23</id>
    </field>
    <field>
      <type>string</type>
      <label type="str">Horaire fin</label>
      <condition>
        <type>django</type>
        <value>not form_var_journee_entiere and not form_var_duree_indeterminee</value>
      </condition>
      <required type="str">optional</required>
      <hint type="str">&lt;p&gt;Ex.&#160;: 22:00&lt;/p&gt;</hint>
      <varname type="str">horaire_fin</varname>
      <display_locations>
        <item>validation</item>
        <item>summary</item>
      </display_locations>
      <extra_css_class type="str">grid-1-3 pk-important</extra_css_class>
      <prefill>
        <type>string</type>
        <value>23:59</value>
      </prefill>
      <anonymise type="str">final</anonymise>
      <validation>
        <type>regex</type>
        <value>^([0-1][0-9]|2[0-3]):[0-5][0-9]$</value>
      </validation>
      <id type="str">24</id>
    </field>
    <field>
      <type>subtitle</type>
      <label type="str">R&#233;currence de l'&#233;v&#233;nement</label>
      <display_locations>
        <item>validation</item>
        <item>summary</item>
      </display_locations>
      <id type="str">c7e09d5d-dad9-480b-9039-b45dce74004b</id>
    </field>
    <field>
      <type>bool</type>
      <label type="str">Cet &#233;v&#233;nement est-il r&#233;current ?</label>
      <required type="str">optional</required>
      <hint type="str">&lt;p&gt;Si oui, les dates et horaires ci-dessus correspondent &#224; la premi&#232;re occurrence de l'&#233;v&#233;nement.&lt;/p&gt;</hint>
      <varname type="str">recurrent</varname>
      <display_locations>
        <item>validation</item>
        <item>summary</item>
      </display_locations>
      <extra_css_class type="str">pk-important</extra_css_class>
      <anonymise type="str">no</anonymise>
      <id type="str">a1f0c001-0000-4000-8000-000000000001</id>
    </field>
    <field>
      <type>item</type>
      <label type="str">Fr&#233;quence de l'&#233;v&#233;nement</label>
      <condition>
        <type>django</type>
        <value>form_var_recurrent</value>
      </condition>
      <required type="str">required</required>
      <varname type="str">rrule_freq</varname>
      <display_locations>
        <item>validation</item>
        <item>summary</item>
      </display_locations>
      <extra_css_class type="str">pk-important</extra_css_class>
      <anonymise type="str">no</anonymise>
      <display_mode type="str">radio</display_mode>
      <items />
      <data_source>
        <type>jsonvalue</type>
        <value>[{"id": "DAILY", "text": "Quotidienne"}, {"id": "WEEKLY", "text": "Hebdomadaire"}, {"id": "MONTHLY", "text": "Mensuelle"}, {"id": "YEARLY", "text": "Annuelle"}]</value>
      </data_source>
      <in_filters type="bool">False</in_filters>
      <display_disabled_items type="bool">False</display_disabled_items>
      <use_hint_as_first_option type="bool">True</use_hint_as_first_option>
      <image_desktop_size type="str">150</image_desktop_size>
      <image_mobile_size type="str">75</image_mobile_size>
      <radio_orientation type="str">horizontal</radio_orientation>
      <id type="str">a1f0c001-0000-4000-8000-000000000002</id>
    </field>
    <field>
      <type>string</type>
      <label type="str">R&#233;p&#233;ter tous les</label>
      <condition>
        <type>django</type>
        <value>form_var_recurrent</value>
      </condition>
      <required type="str">required</required>
      <hint type="str">&lt;p&gt;ex : 2 = un(e) jour/semaine/mois/an sur deux&lt;/p&gt;</hint>
      <varname type="str">rrule_interval</varname>
      <display_locations>
        <item>validation</item>
        <item>summary</item>
      </display_locations>
      <extra_css_class type="str">grid-1-3 pk-important</extra_css_class>
      <prefill>
        <type>string</type>
        <value>1</value>
      </prefill>
      <anonymise type="str">no</anonymise>
      <validation>
        <error_message>Veuillez saisir un nombre entre 1 et 99</error_message>
        <type>regex</type>
        <value>^[1-9][0-9]?$</value>
      </validation>
      <id type="str">a1f0c001-0000-4000-8000-000000000003</id>
    </field>
    <field>
      <type>items</type>
      <label type="str">Jours de la semaine</label>
      <condition>
        <type>django</type>
        <value>form_var_recurrent and form_var_rrule_freq_raw == "WEEKLY"</value>
      </condition>
      <required type="str">optional</required>
      <hint type="str">&lt;p&gt;Si aucun jour n'est coch&#233;, le jour de la date de d&#233;but est utilis&#233;.&lt;/p&gt;</hint>
      <varname type="str">rrule_byday</varname>
      <display_locations>
        <item>validation</item>
        <item>summary</item>
      </display_locations>
      <extra_css_class type="str">pk-important</extra_css_class>
      <anonymise type="str">no</anonymise>
      <items />
      <display_mode type="str">checkboxes</display_mode>
      <min_choices type="int">0</min_choices>
      <max_choices type="int">0</max_choices>
      <data_source>
        <type>jsonvalue</type>
        <value>[{"id": "MO", "text": "Lundi"}, {"id": "TU", "text": "Mardi"}, {"id": "WE", "text": "Mercredi"}, {"id": "TH", "text": "Jeudi"}, {"id": "FR", "text": "Vendredi"}, {"id": "SA", "text": "Samedi"}, {"id": "SU", "text": "Dimanche"}]</value>
      </data_source>
      <in_filters type="bool">False</in_filters>
      <display_disabled_items type="bool">False</display_disabled_items>
      <image_desktop_size type="int">150</image_desktop_size>
      <image_mobile_size type="int">75</image_mobile_size>
      <id type="str">a1f0c001-0000-4000-8000-000000000004</id>
    </field>
    <field>
      <type>item</type>
      <label type="str">R&#233;p&#233;tition mensuelle</label>
      <condition>
        <type>django</type>
        <value>form_var_recurrent and form_var_rrule_freq_raw == "MONTHLY"</value>
      </condition>
      <required type="str">required</required>
      <varname type="str">rrule_mois_mode</varname>
      <display_locations>
        <item>validation</item>
        <item>summary</item>
      </display_locations>
      <extra_css_class type="str">pk-important</extra_css_class>
      <prefill>
        <type>string</type>
        <value>date</value>
      </prefill>
      <anonymise type="str">no</anonymise>
      <display_mode type="str">radio</display_mode>
      <items />
      <data_source>
        <type>jsonvalue</type>
        <value>[{"id": "date", "text": "Le m&#234;me jour du mois (ex : le 15)"}, {"id": "weekday", "text": "Un jour de semaine pr&#233;cis (ex : le 2e mardi)"}]</value>
      </data_source>
      <in_filters type="bool">False</in_filters>
      <display_disabled_items type="bool">False</display_disabled_items>
      <use_hint_as_first_option type="bool">True</use_hint_as_first_option>
      <image_desktop_size type="int">150</image_desktop_size>
      <image_mobile_size type="int">75</image_mobile_size>
      <radio_orientation type="str">horizontal</radio_orientation>
      <id type="str">a1f0c001-0000-4000-8000-000000000005</id>
    </field>
    <field>
      <type>item</type>
      <label type="str">Position dans le mois</label>
      <condition>
        <type>django</type>
        <value>form_var_recurrent and form_var_rrule_freq_raw == "MONTHLY" and form_var_rrule_mois_mode_raw == "weekday"</value>
      </condition>
      <required type="str">required</required>
      <varname type="str">rrule_mois_position</varname>
      <display_locations>
        <item>validation</item>
        <item>summary</item>
      </display_locations>
      <extra_css_class type="str">grid-1-2 pk-important</extra_css_class>
      <anonymise type="str">no</anonymise>
      <display_mode type="str">list</display_mode>
      <items />
      <data_source>
        <type>jsonvalue</type>
        <value>[{"id": "1", "text": "1er"}, {"id": "2", "text": "2e"}, {"id": "3", "text": "3e"}, {"id": "4", "text": "4e"}, {"id": "-1", "text": "Dernier"}]</value>
      </data_source>
      <in_filters type="bool">False</in_filters>
      <display_disabled_items type="bool">False</display_disabled_items>
      <use_hint_as_first_option type="bool">True</use_hint_as_first_option>
      <image_desktop_size type="int">150</image_desktop_size>
      <image_mobile_size type="int">75</image_mobile_size>
      <radio_orientation type="str">horizontal</radio_orientation>
      <id type="str">a1f0c001-0000-4000-8000-000000000006</id>
    </field>
    <field>
      <type>item</type>
      <label type="str">Jour</label>
      <condition>
        <type>django</type>
        <value>form_var_recurrent and form_var_rrule_freq_raw == "MONTHLY" and form_var_rrule_mois_mode_raw == "weekday"</value>
      </condition>
      <required type="str">required</required>
      <varname type="str">rrule_mois_jour</varname>
      <display_locations>
        <item>validation</item>
        <item>summary</item>
      </display_locations>
      <extra_css_class type="str">grid-1-2 pk-important</extra_css_class>
      <anonymise type="str">no</anonymise>
      <display_mode type="str">list</display_mode>
      <items />
      <data_source>
        <type>jsonvalue</type>
        <value>[{"id": "MO", "text": "Lundi"}, {"id": "TU", "text": "Mardi"}, {"id": "WE", "text": "Mercredi"}, {"id": "TH", "text": "Jeudi"}, {"id": "FR", "text": "Vendredi"}, {"id": "SA", "text": "Samedi"}, {"id": "SU", "text": "Dimanche"}]</value>
      </data_source>
      <in_filters type="bool">False</in_filters>
      <display_disabled_items type="bool">False</display_disabled_items>
      <use_hint_as_first_option type="bool">True</use_hint_as_first_option>
      <image_desktop_size type="int">150</image_desktop_size>
      <image_mobile_size type="int">75</image_mobile_size>
      <radio_orientation type="str">horizontal</radio_orientation>
